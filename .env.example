# =============================================================================
# Hack(H)er413 - Applications MVP secrets
# Copy to .env.local for local dev. Real values live in the shared secrets vault
# and in Vercel (Development / Preview / Production).
# =============================================================================

# --- Neon (Postgres) ---------------------------------------------------------
# Neon Console → Project → Connection details → Connection string
# Use the pooled connection string for the Next.js app (runtime).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Direct (unpooled) URL — preferred for `npm run db:migrate` / drizzle-kit.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Clerk (Auth) ------------------------------------------------------------
# Clerk Dashboard → API Keys
# Create separate Clerk applications (or instances) for Development and Production.
# Local / Vercel Preview → Development keys
# Vercel Production → Production keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: only if you add a Clerk webhook (user.created, etc.)
# CLERK_WEBHOOK_SECRET=whsec_...

# Auth route URLs (adjust if your paths differ)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/apply

# Roles (attendee | organizer | admin) are NOT env vars.
# Define them in Clerk (Organizations / Roles, or publicMetadata.role)
# and enforce in app helpers (requireUser / requireOrganizer).

# --- Resend (Email) ----------------------------------------------------------
# Resend Dashboard → API Keys
RESEND_API_KEY=re_...

# Must use a verified domain (hackher413.com after DNS verify).
# Keep the display name as Hack(H)er413 so confirm + decision mail match.
RESEND_FROM_EMAIL="Hack(H)er413 <noreply@hackher413.com>"

# Optional Reply-To for applicant mail (defaults to hackher413@gmail.com)
# RESEND_REPLY_TO=hackher413@gmail.com

# --- Vercel Blob (Resume uploads) --------------------------------------------
# Vercel Dashboard → Storage → Blob store (Private OK)
# Connect Development + Preview + Production, then:
#   vercel env pull .env.local
# Re-add DATABASE_URL / Clerk / Resend if pull overwrote them.
# Client upload tokens need the long-lived read-write token:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Often also present after pull:
# BLOB_STORE_ID=store_...
# VERCEL_OIDC_TOKEN=...   # auto; short-lived

